{
  "description": "Run a SpecBind dogfooding debrief after turns that use SpecBind.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/specbind-debrief.mjs\"",
            "commandWindows": "pwsh -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/specbind-debrief.mjs')\" 2>> \"$env:TEMP\\pc-build-planner-specbind-debrief-hook.log\"",
            "timeout": 5,
            "statusMessage": "SpecBindの利用を記録しています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/specbind-debrief.mjs\"",
            "commandWindows": "pwsh -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/specbind-debrief.mjs')\" 2>> \"$env:TEMP\\pc-build-planner-specbind-debrief-hook.log\"",
            "timeout": 5,
            "statusMessage": "SpecBindの利用を振り返っています"
          }
        ]
      }
    ]
  }
}
