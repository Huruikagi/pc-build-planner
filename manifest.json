{
  "manifest_version": 3,
  "name": "PC Build Planner",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
