{
  "name": "pc-build-planner",
  "version": "0.4.0",
  "description": "Local-first PC build planner Chrome extension",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "26.5.0",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:public-consumer": "tsc --noEmit -p tsconfig.public-consumer.json",
    "typecheck:typed-messages-consumer": "tsc --noEmit -p tsconfig.typed-messages-consumer.json",
    "typecheck:local-data": "pnpm --filter @pc-build-planner/local-data run typecheck",
    "typecheck:local-data-public-declarations": "tsc --noEmit -p tsconfig.local-data-public-declarations.json",
    "typecheck:local-data-public-consumers": "tsc --noEmit -p tsconfig.local-data-public-consumers.json",
    "typecheck:local-data-product-consumers": "tsc --noEmit -p tsconfig.local-data-product-consumers.json",
    "typecheck:local-data-read-only-app-contract": "tsc --noEmit -p tsconfig.local-data-read-only-app-contract.json",
    "clean:local-data": "pnpm --filter @pc-build-planner/local-data run clean",
    "lint": "biome check .",
    "test": "node --import tsx --import ./tests/setup-dom.ts --test --test-reporter=dot tests/**/*.test.ts tests/**/*.test.tsx",
    "install:e2e-browser": "playwright install chromium",
    "test:e2e": "pnpm build && playwright test",
    "build": "pnpm --filter @pc-build-planner/typed-messages-core build && pnpm --filter @pc-build-planner/local-data build && node scripts/build.mjs",
    "test:local-data": "pnpm --filter @pc-build-planner/local-data run test",
    "validate:local-data-public-consumers": "node scripts/validate-local-data-public-consumers.mjs",
    "validate:local-data-read-only-app-contract": "node scripts/validate-local-data-read-only-app-contract.mjs",
    "validate:local-data-boundaries": "node scripts/validate-local-data-boundaries.mjs packages/local-data/src packages/local-data/tests src tests/tooling/local-data-core-consumer.ts tests/tooling/local-data-chrome-consumer.ts tests/tooling/local-data-backup-consumer.ts tests/tooling/local-data-read-only-app-contract.ts",
    "validate:local-data-core": "node scripts/validate-local-data-workspace.mjs core",
    "validate:local-data-chrome": "node scripts/validate-local-data-workspace.mjs chrome",
    "validate:local-data-backup": "node scripts/validate-local-data-workspace.mjs backup",
    "validate:local-data-contracts": "node scripts/validate-local-data-workspace.mjs contracts",
    "validate:local-data": "node scripts/validate-local-data-workspace-final.mjs",
    "validate:local-data:changed": "node scripts/validate-local-data-workspace-final.mjs --changed",
    "validate:local-data-product-contract": "node scripts/validate-local-data-product-contract.mjs",
    "validate:local-data-product-consumers": "node scripts/validate-local-data-product-consumers.mjs",
    "validate:boundaries": "node scripts/validate-boundaries.mjs packages/typed-messages-core/src tests/tooling/typed-messages-consumer.ts src/features src/candidate-sources src/application-shell src/runtime src/ui-language src/project-context src/persistence src/domain tests/tooling/public-api-consumer.ts tests/tooling/candidate-sources-public-consumer.ts tests/tooling/source-price-refresh-consumer.ts tests/tooling/source-price-refresh-public-consumer.ts tests/tooling/source-price-refresh-upstream-consumer.ts tests/tooling/source-price-refresh-duplicate-product-merge-consumer.ts",
    "validate:candidate-source-consumers": "node scripts/validate-candidate-source-consumers.mjs src/candidate-sources src/features/candidate-management/public.ts tests/tooling/candidate-source-editor-consumer.ts tests/tooling/source-price-candidate-sources-consumer.ts tests/tooling/duplicate-product-candidate-sources-consumer.ts",
    "validate:typed-messages-boundaries": "node scripts/validate-boundaries.mjs packages/typed-messages-core/src tests/tooling/typed-messages-consumer.ts",
    "validate:typed-messages-core": "node scripts/validate-typed-messages-core.mjs",
    "validate:fixtures": "node --import tsx scripts/validate-fixture-assets.mjs tests/fixtures tests/fixtures/source-fixture-registry.ts",
    "validate:artifacts": "node scripts/validate-artifacts.mjs dist && node scripts/validate-boundaries.mjs dist && node scripts/validate-fixture-assets.mjs dist --exclude-executables",
    "validate:final-build": "node scripts/validate-final-gate.mjs dist",
    "validate:runtime-schema": "node scripts/validate-runtime-schema-csp.mjs",
    "validate:ui-text": "node scripts/validate-ui-text.mjs src/features src/application-shell src/project-context",
    "validate:ci": "pnpm validate:typed-messages-core && pnpm validate:local-data && pnpm build && pnpm typecheck && pnpm typecheck:public-consumer && pnpm lint && pnpm validate:boundaries && pnpm validate:candidate-source-consumers && pnpm validate:runtime-schema && pnpm validate:fixtures && pnpm validate:final-build && pnpm validate:ui-text && pnpm test",
    "validate": "pnpm validate:ci && playwright test",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@pc-build-planner/local-data": "workspace:*",
    "@pc-build-planner/typed-messages-core": "workspace:*",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "chrome-types": "^0.1.436",
    "esbuild": "0.28.1",
    "global-jsdom": "29.0.0",
    "jsdom": "29.1.1",
    "schema-dts": "^2.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  }
}
